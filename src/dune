(library
 (name mahjong)
 (public_name mahjong)
 (modules :standard \ win_cache_generator)
 (libraries base stdio capnp-rpc-lwt)
 (preprocess
  (pps ppx_jane))
 (flags (:standard -w -53-55)))

(rule
 (targets mjx_proto.ml mjx_proto.mli)
 (deps mjx_proto.capnp)
 (action
  (run capnp compile -o %{bin:capnpc-ocaml} %{deps})))

;; Stage 1: Generate OCaml source code for win cache
(executable
 (name win_cache_generator)
 (modules win_cache_generator)
 (libraries base stdio domainslib unix)
 (preprocess
  (pps ppx_jane)))

(rule
 (target win_cache_data.ml)
 (deps win_cache_generator.exe)
 (action
  (run %{deps})))